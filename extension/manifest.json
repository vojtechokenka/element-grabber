{
  "manifest_version": 3,
  "name": "Element Grabber",
  "version": "1.0.0",
  "description": "Pick any element on a page and copy it as a PNG, or grab its text. One shortcut, no DevTools.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Pick an element",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+X", "mac": "Command+Shift+X" }
    }
  }
}
